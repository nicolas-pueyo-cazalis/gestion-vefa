# Copiez ce fichier en ".env" (jamais commité, voir .gitignore) et remplissez
# les vraies valeurs.

# Chaîne de connexion MongoDB Atlas (menu Atlas : Connect > Drivers > Node.js)
# Remplacez <password> par le mot de passe de l'utilisateur de base de données.
MONGODB_URI=mongodb+srv://<utilisateur>:<password>@cluster0.xxxxx.mongodb.net/gestion-vefa?retryWrites=true&w=majority

# Port sur lequel le serveur Express écoute en local
PORT=4000

# Clé secrète servant à signer/vérifier les jetons JWT (authentification) —
# n'importe quelle longue chaîne aléatoire convient. Générée par exemple
# avec : openssl rand -hex 32
JWT_SECRET=
